# Copy to .env.local and fill in real values. .env.local is gitignored.

# === Database (Neon serverless Postgres) ===
# Get from neon.tech dashboard → construct-app project → Connection string
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# === Auth (Clerk) ===
# Get from clerk.com dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# === File storage (Cloudflare R2) ===
# Get from Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY=xxx
R2_SECRET_KEY=xxx
R2_BUCKET=construct-app-dev

# === Email (Resend) ===
# Get from resend.com → API Keys
RESEND_API_KEY=re_xxx

# === Observability (Sentry) ===
# Get from sentry.io → Settings → Projects → [project] → Client Keys (DSN)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
