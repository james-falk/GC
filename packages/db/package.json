{
  "name": "@constructor/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../apps/web/.env.local -- drizzle-kit generate",
    "migrate": "dotenv -e ../../apps/web/.env.local -- drizzle-kit migrate",
    "studio": "dotenv -e ../../apps/web/.env.local -- drizzle-kit studio",
    "seed": "dotenv -e ../../apps/web/.env.local -- tsx src/seed/run.ts",
    "lint": "echo '(db lint stub)'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
